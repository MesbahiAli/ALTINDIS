# Public HTTPS origin used for canonical URLs and sitemaps.
SITE_URL=
# Use preview on Vercel for client review; production only on the final host.
SITE_STAGE=preview
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# SMTP mailbox for direct form delivery (use your existing email provider).
# Port 465 uses implicit TLS; port 587 requires STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=Contact@Altindis.ma

# Required spam protection for direct form submissions.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Do not commit secrets. Set these in hosting environment settings and redeploy.
